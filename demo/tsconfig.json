{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "agentic-ui": ["../src/index.ts"],
      "agentic-ui/protocol": ["../src/protocol/index.ts"],
      "agentic-ui/core": ["../src/core/index.ts"],
      "agentic-ui/eval": ["../src/eval/index.ts"],
      "agentic-ui/react": ["../src/react/index.ts"],
      "agentic-ui/chat": ["../src/chat/index.ts"],
      "agentic-ui/lib/*": ["../src/lib/*"],
      "agentic-ui/ui/*": ["../src/ui/*"],
      "agentic-ui/ai-elements/*": ["../src/ai-elements/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
