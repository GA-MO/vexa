{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "vexa": ["../../src/index.ts"],
      "vexa/protocol": ["../../src/protocol/index.ts"],
      "vexa/core": ["../../src/core/index.ts"],
      "vexa/server": ["../../src/server/index.ts"],
      "vexa/mock": ["../../src/mock/index.ts"],
      "vexa/react": ["../../src/react/index.ts"],
      "vexa/chat": ["../../src/chat/index.ts"],
      "vexa/lib/*": ["../../src/lib/*"],
      "vexa/ui/*": ["../../src/ui/*"],
      "vexa/ai-elements/*": ["../../src/ai-elements/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
