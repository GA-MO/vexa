{
  "name": "vexa",
  "workspaces": [
    "examples/*",
    "website"
  ],
  "version": "0.1.0",
  "private": true,
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./core": "./src/core/index.ts",
    "./examples": "./src/examples/index.ts",
    "./server": "./src/server/index.ts",
    "./eval": "./src/eval/index.ts",
    "./mock": "./src/mock/index.ts",
    "./admin": "./src/admin/index.ts",
    "./react": "./src/react/index.ts",
    "./chat": "./src/chat/index.ts",
    "./styles.css": "./src/styles.css",
    "./lib/*": "./src/lib/*.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./ai-elements/*": "./src/ai-elements/*.tsx"
  },
  "scripts": {
    "dev": "bun run --cwd examples/shop-admin dev",
    "build": "bun run --cwd examples/shop-admin build",
    "start": "bun run --cwd examples/shop-admin start",
    "dev:widget": "bun run --cwd examples/embedded-widget dev",
    "dev:starter-next": "bun run --cwd examples/starter-next dev",
    "dev:starter-vite": "bun run --cwd examples/starter-vite dev",
    "dev:trial": "bun run --cwd examples/trial-react-admin dev",
    "dev:site": "bun run --cwd website dev",
    "build:site": "bun run --cwd website build",
    "start:site": "bun run --cwd website start",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun run --cwd examples/shop-admin typecheck && bun run --cwd examples/embedded-widget typecheck && bun run --cwd examples/starter-next typecheck && bun run --cwd examples/starter-vite typecheck && bun run --cwd website typecheck",
    "test:scenarios": "bun --cwd examples/shop-admin --preload ./lib/scenarios/register-dom.ts scripts/run-scenarios.ts",
    "eval:ui": "bun --cwd examples/shop-admin --preload ./lib/scenarios/register-dom.ts scripts/eval-ui.ts",
    "probe": "bun --cwd examples/shop-admin --preload ./lib/scenarios/register-dom.ts scripts/probe.ts",
    "generate:reference": "bun run scripts/generate-reference.ts",
    "mcp:build": "bunx --bun vite build --config mcp/vite.config.ts",
    "mcp:stdio": "bun run mcp/server.ts --stdio",
    "mcp:http": "bun run mcp/server.ts",
    "build:pages": "bun run scripts/build-pages.ts",
    "release": "bun run scripts/release.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.48",
    "@ai-sdk/react": "^3.0.84",
    "@base-ui/react": "^1.8.0",
    "@json-render/core": "^0.20.0",
    "@json-render/devtools": "^0.20.0",
    "@json-render/devtools-react": "^0.20.0",
    "@json-render/directives": "^0.20.0",
    "@json-render/mcp": "^0.20.0",
    "@json-render/react": "^0.20.0",
    "@modelcontextprotocol/ext-apps": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^6.0.84",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.563.0",
    "nanoid": "^6.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
